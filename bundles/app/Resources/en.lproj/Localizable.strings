/* Title of the warning shown when a folder could not be opened. */
"app.could-not-open" = "Could not open the folder";

/* Shown when the Finder extension sent something this app does not understand. */
"app.request-not-understood" = "The Finder asked for something this app did not understand.";

/* Shown when the app was removed from the list between the menu opening and the click. */
"app.app-no-longer-exists" = "That app is no longer in your list.";

/* Shown when the app was moved, renamed or removed. %@ is its bundle name. */
"app.app-is-not-installed" = "“%@” is not on this mac any more.";

/* Shown when the folder was moved or removed between the menu opening and the click. */
"app.folder-is-missing" = "That folder is not there any more.";

/* Shown when the thing clicked turned out not to be a folder. */
"app.not-a-folder" = "That is a file, not a folder.";

/* Shown when the system refused to launch the app. %@ is the reason it gave. */
"app.open-refused" = "%@";

/* Menu bar item title. */
"app.menu-title" = "Open Folder In";

/* Menu bar entry opening the window where apps are added and removed. */
"app.edit-apps" = "Edit Apps…";

/* Menu bar entry that closes the app. */
"app.quit" = "Quit Open Folder In";

/* Menu bar entry shown when the Finder extension has not been switched on yet. */
"app.extension-is-off" = "Finder extension is off — turn it on";

/* Menu bar entry shown when the app and the extension cannot share files. */
"app.not-sharing" = "Cannot reach the shared folder — the menu will be empty";

/* Menu bar switch that makes the app start when the mac starts. */
"app.open-at-login" = "Open at Login";

/* Menu bar entry shown when the scope was narrowed to no folders at all. */
"app.appears-nowhere" = "Menu is off — no folders chosen";

/* Menu bar entry shown when every app has been removed. */
"app.no-apps" = "Menu is off — no apps";
